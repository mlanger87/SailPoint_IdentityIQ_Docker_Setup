# ---------------------------------------------------------------------------
# SailPoint installation packages (licensed - never commit)
# ---------------------------------------------------------------------------
installer/*.zip
installer/*.jar
installer/*.war
*.war
SailPoint_identityiq-*.zip

# ---------------------------------------------------------------------------
# Local configuration with credentials
# ---------------------------------------------------------------------------
.env
.env.local

# ---------------------------------------------------------------------------
# Runtime artifacts
# ---------------------------------------------------------------------------
# Logs: ignore the contents, keep the directory - docker-compose.override.yml
# bind-mounts it.
data/logs/*
!data/logs/.gitkeep

data/plugins/*.zip
# Anything a developer drops in for an LDAPS/HTTPS test, including key
# material that must never be committed.
data/certs/*
!data/certs/.gitkeep
*.key
*.p12
*.pfx
*.jks
*.keystore

# The generated HR feed is tracked; any other CSV placed there ("let me
# just try the real extract") is not.
data/hr/*.csv
!data/hr/HR-people.csv

# IIQ keystore, in case site-specific keys are generated
secrets/
*.dat
*.cfg
!**/config/**/*.cfg

# ---------------------------------------------------------------------------
# Reference projects (local analysis only)
# ---------------------------------------------------------------------------
Other SailPoint IdentityIQ Docker Projekts als Reference/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
.idea/
.vscode/
.scratch/
