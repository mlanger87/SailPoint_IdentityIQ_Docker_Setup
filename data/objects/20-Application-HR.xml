<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  ===========================================================================
  HR application: the authoritative source
  ===========================================================================
  Reads data/hr/HR-people.csv through the DelimitedFileConnector and
  creates the identities in IdentityIQ from it.

  The path under "file" is the path INSIDE THE CONTAINER. The connector
  does not upload anything; it opens a file on the filesystem, and the
  CSV is provided through a bind mount from data/hr/. A change to the
  file is therefore effective immediately; just re-run the aggregation.

  The structure follows an export from an 8.5 instance. Not carried over:
    - id/created attributes: IIQ assigns them itself on import
    - PassphraseForPrivateKey: encrypted and bound to the keystore of the
      source instance, hence worthless here
    - fileEncoding="csv": an artefact of the UI, an encoding belongs here

  The delimiter entry is ";" to match the generated CSV.

  Correlation and naming are explicit, not left to the defaults:
    - AccountCorrelationConfig "HR Correlation" (19-CorrelationConfig-HR.xml)
      matches on employeeNumber. Without it the aggregator matched on the
      identity name and the two "Daniel Morgan" rows (1007, 1030) ended up
      on one identity with two HR links: 100 links, 99 identities.
    - CreationRule "HR Identity Creation" (13-Rules-HR.xml) names new
      identities first.last and appends the employee number on a clash
      (daniel.morgan, daniel.morgan.1030). displayName stays "Daniel Morgan"
      for both; the UI shows displayName.
  ===========================================================================
-->
<sailpoint>

  <Application authoritative="true"
               connector="sailpoint.connector.DelimitedFileConnector"
               featuresString="DIRECT_PERMISSIONS, NO_RANDOM_ACCESS, DISCOVER_SCHEMA, MANAGER_LOOKUP"
               icon="enterpriseIcon"
               name="HR-Application"
               profileClass=""
               type="DelimitedFile">

    <AccountCorrelationConfig>
      <Reference class="sailpoint.object.CorrelationConfig"
                 name="HR Correlation"/>
    </AccountCorrelationConfig>

    <CreationRule>
      <Reference class="sailpoint.object.Rule"
                 name="HR Identity Creation"/>
    </CreationRule>

    <Attributes>
      <Map>
        <entry key="file" value="/data/hr/HR-people.csv"/>
        <entry key="delimiter" value=";"/>
        <entry key="fileEncoding" value="UTF-8"/>
        <entry key="filetransport" value="local"/>
        <entry key="parseType" value="delimited"/>
        <entry key="hasHeader">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>
        <entry key="filterEmptyRecords">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>
        <entry key="stopIfLineHasWrongColumnLength">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>
        <entry key="partitionMode" value="auto"/>
        <entry key="group.filetransport" value="local"/>
        <entry key="group.partitionMode" value="auto"/>
        <entry key="group.filterEmptyRecords">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>

        <!--
          Resolves the manager relationship.

          Read the filter as: property is the IDENTITY side, value is the
          ACCOUNT attribute. IIQ looks up the identity whose employeeNumber
          equals the row's managerEmployeeNumber.

          Prerequisite: employeeNumber must be searchable on the identity,
          i.e. have an extendedNumber (see 23-ObjectConfig-Identity.xml).
          Without it the value lives only in the XML blob, the filter finds
          nothing, and the hierarchy stays empty, silently and without any
          error message.

          Second prerequisite: MANAGER_LOOKUP must be in the application's
          featuresString. Without it the filter is never evaluated; it is
          stored anyway, and there is no error message. The DelimitedFile
          templates exported from the UI do not carry the feature; LDAP
          applications do.

          This implies an order: the ObjectConfig must be imported BEFORE
          the first aggregation run. Importing everything in one go
          satisfies this because 23- sorts after 20-; for an attribute
          added later the aggregation must be re-run.
        -->
        <entry key="managerCorrelationFilter">
          <value>
            <Filter operation="EQ" property="employeeNumber" value="managerEmployeeNumber"/>
          </value>
        </entry>

        <entry key="templateApplication" value="DelimitedFile Template"/>
        <entry key="sysDescriptions">
          <value>
            <Map>
              <entry key="en_US" value="Authoritative HR source (CSV)"/>
            </Map>
          </value>
        </entry>
      </Map>
    </Attributes>

    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>

    <!--
      The schema matches the CSV columns. Order is irrelevant here because
      hasHeader=true is set: the connector maps by header row, not by
      position.

      identityAttribute=employeeNumber is the key: it is stable, whereas
      names and mail addresses can change.
    -->
    <Schemas>
      <Schema displayAttribute="displayName"
              identityAttribute="employeeNumber"
              instanceAttribute=""
              nativeObjectType="account"
              objectType="account">
        <AttributeDefinition name="employeeNumber" type="string">
          <Description>Employee number, the unique, stable key</Description>
        </AttributeDefinition>
        <AttributeDefinition name="firstName" type="string">
          <Description>First name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="lastName" type="string">
          <Description>Last name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="displayName" type="string">
          <Description>Display name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="email" type="string">
          <Description>Business e-mail address</Description>
        </AttributeDefinition>
        <AttributeDefinition name="title" type="string">
          <Description>Job title</Description>
        </AttributeDefinition>
        <AttributeDefinition name="department" type="string">
          <Description>Department</Description>
        </AttributeDefinition>
        <AttributeDefinition name="location" type="string">
          <Description>Location</Description>
        </AttributeDefinition>
        <AttributeDefinition name="costCentre" type="string">
          <Description>Cost centre</Description>
        </AttributeDefinition>
        <AttributeDefinition name="employeeType" type="string">
          <Description>Hierarchy level: department-head, team-lead, staff</Description>
        </AttributeDefinition>
        <AttributeDefinition name="phone" type="string">
          <Description>Phone number</Description>
        </AttributeDefinition>
        <AttributeDefinition name="managerEmployeeNumber" type="string">
          <Description>Employee number of the manager</Description>
        </AttributeDefinition>
        <AttributeDefinition name="startDate" type="string">
          <Description>Start date YYYY-MM-DD, drives the joiner</Description>
        </AttributeDefinition>
        <AttributeDefinition name="endDate" type="string">
          <Description>End date YYYY-MM-DD, empty for open-ended employment, drives the leaver</Description>
        </AttributeDefinition>
        <AttributeDefinition name="status" type="string">
          <Description>active, inactive or future, derived from the date fields</Description>
        </AttributeDefinition>
      </Schema>
    </Schemas>

  </Application>

</sailpoint>
