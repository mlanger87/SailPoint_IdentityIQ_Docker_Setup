<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  ===========================================================================
  JDBC application: second target system
  ===========================================================================
  Talks to the database targetdb in the same PostgreSQL container. It is
  created on first start by docker/postgres/03-targetdb.sql.

  Why no separate database instance: the PostgreSQL JDBC driver is
  already in the IIQ image (IIQ itself needs it). A second database
  system would have exercised the same connector but cost ~1.5 GB RAM.

  Modelled on a productive Matrix42 integration:
  provisionRule="operationRule" with five operation rules and one
  BuildMap rule. Deviations from that template:

    - driverClass/url point to PostgreSQL instead of MSSQL.
    - Credentials are in clear text instead of %%APP_..._PASSWORD%%
      placeholders. Those placeholders are replaced by an SSB build
      pipeline that does not exist here; see CLAUDE.md on the decision
      against iiq encrypt in this dev environment.
    - No DISCOVER_SCHEMA in featuresString: the schema is fully defined
      here.

  The target system has two tables:
    IIQData          one row per account
    IIQAccountRoles  the role assignments (multi-value table)

  The SELECT reads only IIQData; the BuildMap rule loads the roles. That
  is exactly what it exists for: a plain JOIN would yield one row per
  role instead of one per account.
  ===========================================================================
-->
<sailpoint>

  <!--
    Correlation via the employee number, as with the LDAP target system.
  -->
  <CorrelationConfig name="JDBC Correlation">
    <AttributeAssignments>
      <Filter operation="EQ" property="employeeNumber" value="IIQID"/>
    </AttributeAssignments>
  </CorrelationConfig>

  <Application connector="sailpoint.connector.JDBCConnector"
               featuresString="PROVISIONING, SYNC_PROVISIONING, SEARCH, ENABLE, ACCOUNT_ONLY_REQUEST"
               icon="databaseIcon"
               name="JDBC-Target"
               profileClass=""
               type="JDBC">

    <AccountCorrelationConfig>
      <Reference class="sailpoint.object.CorrelationConfig"
                 name="JDBC Correlation"/>
    </AccountCorrelationConfig>

    <Attributes>
      <Map>
        <entry key="driverClass" value="org.postgresql.Driver"/>
        <entry key="url" value="jdbc:postgresql://postgres:5432/targetdb"/>
        <entry key="user" value="targetapp"/>
        <entry key="password" value="targetapp"/>

        <!--
          The aggregation SELECT. Reads only the account table; the
          BuildMap rule adds the roles.
        -->
        <entry key="SQL" value="SELECT * FROM targetapp.&quot;IIQData&quot;"/>

        <!--
          Single-account lookup, e.g. when re-reading after provisioning.
          IIQ replaces $(identity) with the NativeIdentity.
        -->
        <entry key="getObjectSQL"
               value="SELECT * FROM targetapp.&quot;IIQData&quot; WHERE &quot;IIQID&quot; = '$(identity)'"/>

        <entry key="testConnSQL" value="SELECT 1"/>

        <entry key="aggregationType" value="account"/>

        <!-- Rules for reading and writing. -->
        <entry key="buildMapRule" value="JDBC-Target BuildMap"/>
        <entry key="provisionRule" value="operationRule"/>
        <entry key="jdbcCreateProvisioningRule"  value="JDBC-Target Create"/>
        <entry key="jdbcModifyProvisioningRule"  value="JDBC-Target Modify"/>
        <entry key="jdbcDeleteProvisioningRule"  value="JDBC-Target Delete"/>
        <entry key="jdbcEnableProvisioningRule"  value="JDBC-Target Enable"/>
        <entry key="jdbcDisableProvisioningRule" value="JDBC-Target Disable"/>

        <!--
          Collects errors of individual rows instead of aborting the
          whole aggregation. Much more pleasant with test data that has
          the occasional dirty row.
        -->
        <entry key="jdbcExceptionBucketing">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>

        <entry key="connRetryEnable">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>
        <entry key="connMaxRetry" value="3"/>
        <entry key="connWaitTimeForRetry" value="2"/>

        <entry key="templateApplication" value="JDBC Template"/>
        <entry key="sysDescriptions">
          <value>
            <Map>
              <entry key="en_US" value="JDBC target system (PostgreSQL)"/>
            </Map>
          </value>
        </entry>
      </Map>
    </Attributes>

    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>

    <!--
      Create policy: derives the column values from the identity. The
      field names match the columns of IIQData; the Create rule reads
      them from the ProvisioningPlan.
    -->
    <ProvisioningForms>
      <Form name="Create Account" objectType="account" type="Create">
        <Attributes>
          <Map>
            <entry key="pageTitle" value="Create Account"/>
          </Map>
        </Attributes>
        <Section name="Account">
          <Field name="IIQID" required="true" type="string">
            <Script>
              <Source><![CDATA[
                // The correlation key. Without it the account could not
                // be matched to the identity on the next aggregation.
                return identity.getStringAttribute("employeeNumber");
              ]]></Source>
            </Script>
          </Field>

          <!--
            Same derivation as the LDAP uid, from the shared rule in
            12-Rules-Lifecycle.xml rather than a third copy of it.
          -->
          <Field name="Account" type="string">
            <RuleRef>
              <Reference class="sailpoint.object.Rule" name="HR Derive Account Name"/>
            </RuleRef>
          </Field>

          <Field name="FirstName" type="string">
            <Script>
              <Source><![CDATA[return identity.getFirstname();]]></Source>
            </Script>
          </Field>

          <Field name="LastName" type="string">
            <Script>
              <Source><![CDATA[return identity.getLastname();]]></Source>
            </Script>
          </Field>

          <Field name="Name" type="string">
            <Script>
              <Source><![CDATA[return identity.getDisplayableName();]]></Source>
            </Script>
          </Field>

          <Field name="Email" type="string">
            <Script>
              <Source><![CDATA[return identity.getEmail();]]></Source>
            </Script>
          </Field>

          <Field name="Phone" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("phone");]]></Source>
            </Script>
          </Field>

          <Field name="Position" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("jobTitle");]]></Source>
            </Script>
          </Field>

          <Field name="Department" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("department");]]></Source>
            </Script>
          </Field>

          <Field name="Costcenter" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("costCentre");]]></Source>
            </Script>
          </Field>

          <Field name="Location" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("location");]]></Source>
            </Script>
          </Field>

          <Field name="EmploymentType" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("employeeType");]]></Source>
            </Script>
          </Field>

          <Field name="Status" type="string" value="active"/>
        </Section>
      </Form>
    </ProvisioningForms>

    <Schemas>
      <!--
        IIQID is the identityAttribute, the value by which IIQ recognizes
        an account. Deliberately not the column ID: that is a database
        auto-value and still unknown at create time.
      -->
      <Schema displayAttribute="Name"
              identityAttribute="IIQID"
              instanceAttribute=""
              nativeObjectType="account"
              objectType="account">
        <AttributeDefinition name="ID" type="string">
          <Description>Technical database key</Description>
        </AttributeDefinition>
        <AttributeDefinition name="IIQID" type="string">
          <Description>Employee number, the correlation key</Description>
        </AttributeDefinition>
        <AttributeDefinition name="Account" type="string">
          <Description>Login name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="FirstName" type="string">
          <Description>First name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="LastName" type="string">
          <Description>Last name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="Name" type="string">
          <Description>Display name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="Email" type="string">
          <Description>E-mail address</Description>
        </AttributeDefinition>
        <AttributeDefinition name="Phone" type="string">
          <Description>Phone number</Description>
        </AttributeDefinition>
        <AttributeDefinition name="Position" type="string">
          <Description>Job title</Description>
        </AttributeDefinition>
        <AttributeDefinition name="Department" type="string">
          <Description>Department</Description>
        </AttributeDefinition>
        <AttributeDefinition name="Costcenter" type="string">
          <Description>Cost centre</Description>
        </AttributeDefinition>
        <AttributeDefinition name="Location" type="string">
          <Description>Location</Description>
        </AttributeDefinition>
        <AttributeDefinition name="EmploymentType" type="string">
          <Description>Employment type</Description>
        </AttributeDefinition>
        <AttributeDefinition name="Status" type="string">
          <Description>active or disabled (the target's own status values)</Description>
        </AttributeDefinition>
        <!--
          Multi-valued and flagged as entitlement: these values appear in
          IIQ as entitlements and can be bundled into roles. They do not
          come from the SELECT but from the BuildMap rule.
        -->
        <AttributeDefinition entitlement="true" managed="true" multi="true"
                             name="roles" type="string">
          <Description>Roles in the target system</Description>
        </AttributeDefinition>
      </Schema>
    </Schemas>

  </Application>

</sailpoint>
