<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  ===========================================================================
  Lifecycle events: joiner and leaver
  ===========================================================================
  The chain at a glance:

      HR CSV (startDate/endDate)
          -> rule "HR Set Inactive" computes the attribute inactive
              -> IdentityTrigger detects the change
                  -> workflow provisions or disables

  The structure follows the shipped triggers "Joiner" and "Leaver"
  (inspect with: get IdentityTrigger Leaver). What matters:

    - The workflow is referenced through the ATTRIBUTE handler and the
      HandlerParameters, not through an element. There is no <Handler>
      element; the DTD lists only AssignedScope, Description, Owner,
      HandlerParameters, PendingWorkflow, TriggerRule and Selector.

    - For the joiner, type="AttributeChange" with oldValueFilter and
      newValueFilter is sufficient. The leaver needs a TriggerRule
      (type="Rule", "HR Leaver Trigger" in 12-Rules-Lifecycle.xml),
      because MatchTerm cannot test "is not null"; see below.

  Deviation from the shipped Joiner: that one uses type="Create", i.e.
  fires when the identity is created. That does not fit here: with a
  future start date the identity exists long before the first working
  day. It is therefore triggered by the same attribute change as the
  leaver, only in the opposite direction.

  The shipped triggers remain untouched and disabled.
  ===========================================================================
-->
<sailpoint>

  <!-- ===================================================================
       Joiner: inactive flips from true to false
       ===================================================================
       Fires as soon as the start date is reached; the rule
       "HR Set Inactive" then returns false.
  -->
  <IdentityTrigger name="HR Joiner"
                   attributeName="inactive"
                   oldValueFilter="true"
                   newValueFilter="false"
                   type="AttributeChange"
                   handler="sailpoint.api.WorkflowTriggerHandler"
                   disabled="false">
    <Description>
      Starts the joiner workflow as soon as the start date is reached and
      the identity thereby becomes active.
    </Description>
    <HandlerParameters>
      <Attributes>
        <Map>
          <entry key="workflow" value="HR Joiner Workflow"/>
        </Map>
      </Attributes>
    </HandlerParameters>
  </IdentityTrigger>

  <Workflow explicitTransitions="true"
            name="HR Joiner Workflow"
            type="IdentityLifecycle">
    <Description>
      Creates the accounts in the target systems for a newly joined
      identity, derived from the assigned roles.
    </Description>
    <Variable input="true" name="identityName">
      <Description>Name of the triggering identity</Description>
    </Variable>
    <Variable input="true" name="trigger"/>
    <Variable input="true" name="identity"/>
    <Variable input="true" name="previousIdentity"/>
    <Variable initializer="false" name="trace"/>
    <Variable name="plan"/>
    <Variable name="project"/>

    <Step icon="Start" name="Start" posX="28" posY="10">
      <Transition to="Build plan"/>
    </Step>

    <!--
      Returning person: the leaver disabled the target accounts and a
      refresh does not enable them again (the role is satisfied by the
      existing, disabled account). So the accounts IIQ knows as disabled
      get an explicit Enable first; for a brand-new joiner the list is
      empty and the step is skipped. Measured before this step: joiner
      run Success, WebService account still iiqDisabled=true.
    -->
    <Step icon="Task" name="Build plan" posX="130" posY="10" resultVariable="plan">
      <Script>
        <Source><![CDATA[
          import java.util.List;
          import sailpoint.object.Identity;
          import sailpoint.object.Link;
          import sailpoint.object.ProvisioningPlan;
          import sailpoint.object.ProvisioningPlan.AccountRequest;
          Identity ident = context.getObjectByName(Identity.class, identityName);
          if (ident == null || ident.getLinks() == null) {
              return null;
          }
          ProvisioningPlan p = new ProvisioningPlan();
          p.setIdentity(ident);
          for (Link link : ident.getLinks()) {
              if (!link.isDisabled()) {
                  continue;
              }
              if (link.getApplication() != null
                      && link.getApplication().isAuthoritative()) {
                  continue;
              }
              AccountRequest req = new AccountRequest();
              req.setApplication(link.getApplicationName());
              req.setNativeIdentity(link.getNativeIdentity());
              req.setOperation(AccountRequest.Operation.Enable);
              p.add(req);
          }
          return (p.getAccountRequests() != null
                  && !p.getAccountRequests().isEmpty()) ? p : null;
        ]]></Source>
      </Script>
      <Transition to="Compile" when="script:return plan != null"/>
      <Transition to="Refresh"/>
    </Step>

    <Step action="call:compileProvisioningProject"
          icon="Task"
          name="Compile"
          posX="240"
          posY="60"
          resultVariable="project">
      <Arg name="plan" value="ref:plan"/>
      <Arg name="identityName" value="ref:identityName"/>
      <Transition to="Provision"/>
    </Step>

    <Step action="call:provisionProject"
          icon="Task"
          name="Provision"
          posX="350"
          posY="60">
      <Arg name="project" value="ref:project"/>
      <Transition to="Refresh"/>
    </Step>

    <!--
      The create plan is not built by hand: role assignment follows from
      the bundles' selectors, and refreshIdentity derives the required
      account creations from it. A hand-written plan would duplicate that
      logic and fall out of step on every role change.
    -->
    <Step action="call:refreshIdentity"
          icon="Task"
          name="Refresh"
          posX="240"
          posY="10">
      <Description>
        Evaluates the roles and provisions whatever is missing.
      </Description>
      <Arg name="identityName" value="ref:identityName"/>
      <Arg name="correlateEntitlements" value="true"/>
      <Arg name="provision" value="true"/>
      <Transition to="Log"/>
    </Step>

    <Step icon="Message" name="Log" posX="240" posY="10">
      <Script>
        <Source><![CDATA[
          import org.apache.commons.logging.LogFactory;
          LogFactory.getLog("iiq.lifecycle").info(
              "Joiner executed for: " + identityName);
        ]]></Source>
      </Script>
      <Transition to="End"/>
    </Step>

    <Step icon="Stop" name="End" posX="350" posY="10"/>
  </Workflow>

  <!-- ===================================================================
       Leaver: inactive flips from false to true
       =================================================================== -->
  <!--
    type="Rule" instead of "AttributeChange": the rule checks the change
    itself AND separates it from the joiner case. Whether IIQ evaluates
    an additional TriggerRule at all with type="AttributeChange" is not
    documented; none of the shipped triggers combines both. With
    type="Rule" the evaluation is unambiguous.
  -->
  <IdentityTrigger name="HR Leaver"
                   type="Rule"
                   handler="sailpoint.api.WorkflowTriggerHandler"
                   disabled="false">
    <Description>
      Starts the leaver workflow as soon as the end date is reached.
    </Description>
    <!--
      Separation from the joiner via a TriggerRule.

      Both groups flip inactive from false to true; an identity with a
      future start date is first created active and then locked.

      A Selector with MatchTerm was NOT sufficient here: for future
      starts endDate is null, not empty, and negative="true" with
      value="" also matches null. Measured: 10 leaver runs for 4 real
      leavers.
    -->
    <TriggerRule>
      <Reference class="sailpoint.object.Rule" name="HR Leaver Trigger"/>
    </TriggerRule>
    <HandlerParameters>
      <Attributes>
        <Map>
          <entry key="workflow" value="HR Leaver Workflow"/>
        </Map>
      </Attributes>
    </HandlerParameters>
  </IdentityTrigger>

  <Workflow explicitTransitions="true"
            name="HR Leaver Workflow"
            type="IdentityLifecycle">
    <Description>
      Disables the accounts of a departed identity in all target systems.
    </Description>
    <Variable input="true" name="identityName"/>
    <Variable input="true" name="trigger"/>
    <Variable input="true" name="identity"/>
    <Variable input="true" name="previousIdentity"/>
    <Variable initializer="false" name="trace"/>
    <Variable name="plan"/>
    <Variable name="project"/>

    <Step icon="Start" name="Start" posX="28" posY="10">
      <Transition to="Build plan"/>
    </Step>

    <!--
      Here the plan is deliberately built by hand: the goal is disabling,
      not deleting. A refresh would remove the accounts as soon as the
      roles drop away; the data must be retained for audit reasons.

      Separation from the joiner case: the trigger also fires when
      someone with a future start date is created (inactive=true).
      Without an end date nothing may be disabled then.
    -->
    <Step icon="Task" name="Build plan" posX="130" posY="10" resultVariable="plan">
      <Script>
        <Source><![CDATA[
          import java.util.List;
          import sailpoint.object.Identity;
          import sailpoint.object.Link;
          import sailpoint.object.ProvisioningPlan;
          import sailpoint.object.ProvisioningPlan.AccountRequest;
          import sailpoint.tools.Util;

          Identity ident = context.getObjectByName(Identity.class, identityName);
          if (ident == null) {
              return null;
          }

          // Without an end date this is not a departure but a start not
          // yet reached.
          String endDate = ident.getStringAttribute("endDate");
          if (Util.isNullOrEmpty(endDate)) {
              return null;
          }

          List links = ident.getLinks();
          if (links == null || links.isEmpty()) {
              return null;
          }

          ProvisioningPlan p = new ProvisioningPlan();
          p.setIdentity(ident);

          for (Link link : links) {
              // Authoritative sources (HR) are not target systems;
              // nothing is changed there. Checked via the application
              // flag, not a hard-coded name, so a second HR feed is
              // skipped as well.
              if (link.getApplication() != null
                      && link.getApplication().isAuthoritative()) {
                  continue;
              }
              String app = link.getApplicationName();

              AccountRequest req = new AccountRequest();
              req.setApplication(app);
              req.setNativeIdentity(link.getNativeIdentity());
              req.setOperation(AccountRequest.Operation.Disable);
              p.add(req);
          }

          return (p.getAccountRequests() != null
                  && !p.getAccountRequests().isEmpty()) ? p : null;
        ]]></Source>
      </Script>
      <Transition to="Compile" when="script:return plan != null"/>
      <Transition to="Log"/>
    </Step>

    <!--
      Two steps, as in the shipped workflows (see
      workflow-identityCorrelation.xml): the plan is first compiled into
      a ProvisioningProject, and only the project is executed.
      provisionProject takes the argument "project", not "plan"; handed
      the plan it fails with "Missing argument: project" and the case
      stays open.
    -->
    <Step action="call:compileProvisioningProject"
          icon="Task"
          name="Compile"
          posX="240"
          posY="10"
          resultVariable="project">
      <Arg name="plan" value="ref:plan"/>
      <Arg name="identityName" value="ref:identityName"/>
      <Transition to="Provision"/>
    </Step>

    <Step action="call:provisionProject"
          icon="Task"
          name="Provision"
          posX="350"
          posY="10">
      <Arg name="project" value="ref:project"/>
      <Arg name="identityName" value="ref:identityName"/>
      <Transition to="Log"/>
    </Step>

    <Step icon="Message" name="Log" posX="460" posY="10">
      <Script>
        <Source><![CDATA[
          import org.apache.commons.logging.LogFactory;
          LogFactory.getLog("iiq.lifecycle").info(
              "Leaver executed for: " + identityName);
        ]]></Source>
      </Script>
      <Transition to="End"/>
    </Step>

    <Step icon="Stop" name="End" posX="570" posY="10"/>
  </Workflow>

</sailpoint>
