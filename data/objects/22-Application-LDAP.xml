<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  ===========================================================================
  LDAP application: the target system
  ===========================================================================
  Not authoritative: this directory does not create identities, it
  receives the accounts IdentityIQ creates there.

  The structure follows an export from an 8.5 instance. Deviations, each
  adapted to our directory:

    - Group schema: the export used groupOfUniqueNames with uniqueMember.
      Our OpenLDAP holds groups as groupOfNames with member. Taking the
      export as-is, group aggregation would find nothing.

    - host/port: openldap:1389 instead of host.example.com:389 (the
      container name on the Docker network, not localhost).

    - password: in clear text. The export held an encrypted value
      (1:ACP:...), bound to the keystore of the source instance and
      worthless here. See CLAUDE.md on the decision against iiq encrypt
      in this dev environment.

    - searchDNs: the 8.5 structure (list of maps) was kept, with
      ou=people as search base.

  The placeholder cn=placeholder,dc=example,dc=com sits outside ou=people
  and is therefore not picked up by account aggregation.
  ===========================================================================
-->
<sailpoint>

  <Application connector="sailpoint.connector.LDAPConnector"
               featuresString="AUTHENTICATE, MANAGER_LOOKUP, SEARCH, PROVISIONING, SYNC_PROVISIONING, ENABLE, UNLOCK, PASSWORD, ACCOUNT_ONLY_REQUEST"
               icon="directory2Icon"
               name="LDAP-Target"
               profileClass=""
               type="LDAP">

    <!--
      Correlation against the HR identities. Deliberately on
      employeeNumber, not on cn: names are not unique (there are already
      two people here with the same name pattern) and they change on
      marriage or renaming.
    -->
    <AccountCorrelationConfig>
      <Reference class="sailpoint.object.CorrelationConfig"
                 name="LDAP Correlation"/>
    </AccountCorrelationConfig>

    <Attributes>
      <Map>
        <entry key="host" value="openldap"/>
        <entry key="port" value="1389"/>
        <entry key="user" value="cn=admin,dc=example,dc=com"/>
        <entry key="password" value="adminpassword"/>
        <entry key="authorizationType" value="simple"/>
        <entry key="useSSL">
          <value>
            <Boolean></Boolean>
          </value>
        </entry>

        <entry key="authSearchAttributes">
          <value>
            <List>
              <String>cn</String>
              <String>uid</String>
              <String>mail</String>
            </List>
          </value>
        </entry>

        <!-- 8.5 structure: list of maps instead of a flat searchDN. -->
        <entry key="searchDNs">
          <value>
            <List>
              <Map>
                <entry key="searchDN" value="ou=people,dc=example,dc=com"/>
                <entry key="searchScope" value="SUBTREE"/>
                <entry key="iterateSearchFilter" value="(objectClass=inetOrgPerson)"/>
                <entry key="groupMembershipSearchDN" value="ou=groups,dc=example,dc=com"/>
                <entry key="groupMemberFilterString"/>
                <entry key="primaryGroupSearchDN"/>
              </Map>
            </List>
          </value>
        </entry>
        <entry key="searchScope" value="SUBTREE"/>

        <entry key="group.searchDN" value="ou=groups,dc=example,dc=com"/>
        <entry key="group.searchScope" value="SUBTREE"/>
        <entry key="group.iterateSearchFilter" value="(objectClass=groupOfNames)"/>
        <entry key="groupEntitlementAttr" value="groups"/>

        <entry key="passwordAttr" value="userPassword"/>
        <entry key="pageSize" value="100"/>
        <entry key="deltaIterationMode" value="MODIFY_TIMESTAMP"/>

        <entry key="nativeChangeDetectionAttributeScope" value="entitlements"/>
        <entry key="nativeChangeDetectionEnabled">
          <value>
            <Boolean></Boolean>
          </value>
        </entry>

        <!--
          Enable/Disable (UI section "Enable Disable Configuration").
          OpenLDAP has no account flag; the ppolicy overlay's
          pwdAccountLockedTime with the magic value 000001010000Z locks an
          entry permanently. Disable and Enable are configured separately
          and each fails with "No revoke/restore attribute is specified"
          when its three entries are missing. Action semantics from the
          connector's disableObject()/enableObject(): "add" -> Add,
          "replace" -> Set (Remove if the value is empty), anything else
          -> Remove of that value. Enable therefore removes exactly the
          value Disable set.
          Requires LDAP_CONFIGURE_PPOLICY=yes on the openldap container;
          measured without it: "attribute type undefined" and the leaver's
          LDAP disable fails while the REST target is disabled fine.
        -->
        <entry key="revokeAttr" value="pwdAccountLockedTime"/>
        <entry key="revokeVal" value="000001010000Z"/>
        <entry key="revokeAction" value="replace"/>
        <entry key="restoreAttr" value="pwdAccountLockedTime"/>
        <entry key="restoreVal" value="000001010000Z"/>
        <entry key="restoreAction" value="remove"/>

        <entry key="templateApplication" value="LDAP Template"/>
        <entry key="sysDescriptions">
          <value>
            <Map>
              <entry key="en_US" value="LDAP target system for provisioning"/>
            </Map>
          </value>
        </entry>
      </Map>
    </Attributes>

    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>

    <!--
      Create policy: derives the account attributes from the identity.
      Without it aggregation works, but no account can be created: IIQ
      would not know which DN the new entry should get.

      The DN follows the pattern of the seed accounts
      (uid=<name>,ou=people) so that provisioned and pre-existing accounts
      look alike. The name itself comes from the shared FieldValue rule
      "HR Derive Account Name" (12-Rules-Lifecycle.xml), which also
      handles collisions; the JDBC policy uses the same rule.

      The fields title, departmentNumber, ou, l, employeeType,
      telephoneNumber and description mirror what the seed accounts
      carry, so a provisioned entry is indistinguishable from a seeded
      one.
    -->
    <ProvisioningForms>
      <Form name="Account" objectType="account" type="Create">
        <Attributes>
          <Map>
            <entry key="pageTitle" value="Account"/>
          </Map>
        </Attributes>
        <Section>
          <Field displayName="con_prov_policy_ldap_user_DN"
                 helpKey="help_con_prov_policy_ldap_user_DN"
                 name="dn" required="true" type="string">
            <Script>
              <Source><![CDATA[
                // Same rule, same arguments as the uid field below, so
                // the RDN and the uid attribute cannot diverge.
                import java.util.HashMap;
                import java.util.Map;
                import sailpoint.object.Rule;

                Map args = new HashMap();
                args.put("identity", identity);
                if (application != void) { args.put("application", application); }
                if (field != void)       { args.put("field", field); }
                if (form != void)        { args.put("form", form); }
                if (current != void)     { args.put("current", current); }

                Rule rule = context.getObjectByName(Rule.class, "HR Derive Account Name");
                String uid = (String) context.runRule(rule, args);
                return "uid=" + uid + ",ou=people,dc=example,dc=com";
              ]]></Source>
            </Script>
          </Field>

          <Field displayName="con_prov_policy_ldap_password"
                 helpKey="help_con_prov_policy_ldap_password"
                 name="password" required="true" type="secret">
            <Script>
              <Source><![CDATA[
                // Initial password. Fixed in a dev environment; in
                // production this would be a password policy or a random
                // value with subsequent delivery.
                return "Start123!";
              ]]></Source>
            </Script>
          </Field>

          <Field displayName="con_prov_policy_ldap_full_name"
                 helpKey="help_con_prov_policy_ldap_full_name"
                 name="cn" required="true" type="string">
            <Script>
              <Source><![CDATA[
                return identity.getDisplayName() != null
                     ? identity.getDisplayName()
                     : identity.getName();
              ]]></Source>
            </Script>
          </Field>

          <Field displayName="con_prov_policy_ldap_first_name"
                 helpKey="help_con_prov_policy_ldap_first_name"
                 name="givenName" type="string">
            <Script>
              <Source><![CDATA[return identity.getFirstname();]]></Source>
            </Script>
          </Field>

          <Field displayName="con_prov_policy_ldap_last_name"
                 helpKey="help_con_prov_policy_ldap_last_name"
                 name="sn" required="true" type="string">
            <Script>
              <Source><![CDATA[return identity.getLastname();]]></Source>
            </Script>
          </Field>

          <!--
            Without objectClass OpenLDAP rejects the entry. inetOrgPerson
            requires organizationalPerson, person and top, so all four
            must be listed.
          -->
          <Field name="objectClass" multi="true" type="string">
            <Script>
              <Source><![CDATA[
                java.util.List classes = new java.util.ArrayList();
                classes.add("inetOrgPerson");
                classes.add("organizationalPerson");
                classes.add("person");
                classes.add("top");
                return classes;
              ]]></Source>
            </Script>
          </Field>

          <Field name="uid" type="string">
            <RuleRef>
              <Reference class="sailpoint.object.Rule" name="HR Derive Account Name"/>
            </RuleRef>
          </Field>

          <Field name="mail" type="string">
            <Script>
              <Source><![CDATA[return identity.getEmail();]]></Source>
            </Script>
          </Field>

          <Field name="employeeNumber" type="string">
            <Script>
              <Source><![CDATA[
                // Writes the correlation key right away; otherwise the
                // newly created account would not correlate back on the
                // next aggregation.
                return identity.getStringAttribute("employeeNumber");
              ]]></Source>
            </Script>
          </Field>

          <Field name="title" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("jobTitle");]]></Source>
            </Script>
          </Field>

          <Field name="departmentNumber" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("department");]]></Source>
            </Script>
          </Field>

          <Field name="ou" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("department");]]></Source>
            </Script>
          </Field>

          <Field name="l" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("location");]]></Source>
            </Script>
          </Field>

          <Field name="employeeType" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("employeeType");]]></Source>
            </Script>
          </Field>

          <Field name="telephoneNumber" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("phone");]]></Source>
            </Script>
          </Field>

          <Field name="description" type="string">
            <Script>
              <Source><![CDATA[
                String cc = identity.getStringAttribute("costCentre");
                return (cc != null) ? "Cost centre " + cc : null;
              ]]></Source>
            </Script>
          </Field>
        </Section>
      </Form>

      <Form name="Create Group" objectType="group" type="Create">
        <Attributes>
          <Map>
            <entry key="pageTitle" value="Create Group"/>
          </Map>
        </Attributes>
        <Section>
          <Field displayName="con_prov_policy_ldap_group_DN"
                 helpKey="help_con_prov_policy_ldap_group_DN"
                 name="dn" required="true" reviewRequired="true" type="string"/>
          <Field displayName="con_prov_policy_ldap_description"
                 helpKey="help_con_prov_policy_ldap_description"
                 name="description" reviewRequired="true" type="string"/>
        </Section>
      </Form>

      <Form name="Update Group" objectType="group" type="Update">
        <Attributes>
          <Map>
            <entry key="pageTitle" value="Update Group"/>
          </Map>
        </Attributes>
        <Section>
          <Field displayName="con_prov_policy_ldap_owner" name="owner" type="string"/>
          <Field displayName="con_prov_policy_ldap_common_name" name="cn" type="string"/>
          <Field displayName="con_prov_policy_ldap_object_class" multi="true"
                 name="objectClass" type="string"/>
          <Field displayName="con_prov_policy_ldap_description"
                 name="description" type="string"/>
        </Section>
      </Form>
    </ProvisioningForms>

    <Schemas>
      <!--
        Account schema. Trimmed against the full export to the attributes
        that actually occur in the directory; the export lists around 40
        inetOrgPerson attributes, most of which would stay empty here.
      -->
      <Schema displayAttribute="cn"
              identityAttribute="dn"
              instanceAttribute=""
              nativeObjectType="inetOrgPerson"
              objectType="account">
        <AttributeDefinition name="dn" type="string">
          <Description>Distinguished Name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="uid" type="string">
          <Description>User ID</Description>
        </AttributeDefinition>
        <AttributeDefinition name="cn" type="string">
          <Description>Full name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="sn" type="string">
          <Description>Last name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="givenName" type="string">
          <Description>First name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="mail" type="string">
          <Description>E-mail address</Description>
        </AttributeDefinition>
        <AttributeDefinition name="employeeNumber" type="string">
          <Description>Employee number, the correlation key</Description>
        </AttributeDefinition>
        <AttributeDefinition name="employeeType" type="string">
          <Description>Hierarchy level</Description>
        </AttributeDefinition>
        <AttributeDefinition name="title" type="string">
          <Description>Job title</Description>
        </AttributeDefinition>
        <AttributeDefinition name="departmentNumber" type="string">
          <Description>Department</Description>
        </AttributeDefinition>
        <AttributeDefinition name="ou" type="string">
          <Description>Organizational unit</Description>
        </AttributeDefinition>
        <AttributeDefinition name="l" type="string">
          <Description>Location</Description>
        </AttributeDefinition>
        <AttributeDefinition name="telephoneNumber" type="string">
          <Description>Phone number</Description>
        </AttributeDefinition>
        <AttributeDefinition name="description" type="string">
          <Description>Description</Description>
        </AttributeDefinition>
        <AttributeDefinition name="manager" type="string">
          <Description>DN of the manager</Description>
        </AttributeDefinition>
        <AttributeDefinition multi="true" name="objectClass" type="string">
          <Description>Object classes of the entry</Description>
        </AttributeDefinition>
        <AttributeDefinition entitlement="true" managed="true" multi="true"
                             name="groups" schemaObjectType="group" type="string">
          <Description>Group memberships, the entitlements</Description>
        </AttributeDefinition>
      </Schema>

      <!--
        Group schema. IMPORTANT: groupOfNames with member.

        The 8.5 export used groupOfUniqueNames with uniqueMember. That
        suits directories carrying that class; ours uses groupOfNames.
        Both values must match, otherwise group aggregation returns
        nothing.

        GROUPS_HAVE_MEMBERS makes IIQ resolve membership through the group
        rather than through an attribute on the account: with
        groupOfNames the relationship lives on the group.
      -->
      <Schema descriptionAttribute="description"
              displayAttribute="cn"
              featuresString="PROVISIONING, GROUPS_HAVE_MEMBERS"
              identityAttribute="dn"
              instanceAttribute=""
              nativeObjectType="groupOfNames"
              objectType="group">
        <AttributeDefinition name="dn" type="string">
          <Description>Distinguished Name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="cn" type="string">
          <Description>Group name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="description" type="string">
          <Description>Description of the entitlement</Description>
        </AttributeDefinition>
        <AttributeDefinition name="owner" type="string">
          <Description>Owner</Description>
        </AttributeDefinition>
        <Attributes>
          <Map>
            <entry key="groupMemberAttribute" value="member"/>
          </Map>
        </Attributes>
      </Schema>
    </Schemas>

  </Application>

</sailpoint>
