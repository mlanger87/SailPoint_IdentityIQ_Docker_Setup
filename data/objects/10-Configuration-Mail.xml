<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  ===========================================================================
  Redirect outbound mail to the Mailpit container.

  Deliberately an ImportAction name='merge': only the keys listed here are
  changed, the rest of the SystemConfiguration stays untouched. A full
  overwrite would break on every IIQ upgrade.

  Reference project A does this with "sed" on init.xml, which is
  destructive and does not survive an upgrade.

  Mailpit UI: http://localhost:8025
  ===========================================================================
-->
<sailpoint>

  <ImportAction name='merge'>
    <Configuration name="SystemConfiguration">
      <Attributes>
        <Map>
          <entry key="defaultEmailHost" value="mailpit"/>
          <entry key="defaultEmailPort" value="1025"/>
          <entry key="defaultEmailFromAddress" value="identityiq@example.com"/>
          <entry key="emailNotifierType" value="smtp"/>

          <!-- No authentication, no TLS: Mailpit accepts everything. -->
          <entry key="smtpUser" value=""/>
          <entry key="smtpPassword" value=""/>
          <entry key="emailSSLEnabled" value="false"/>
          <entry key="emailTLSEnabled" value="false"/>

          <!--
            In a development environment mail must actually be sent (to
            Mailpit), not silently discarded.
          -->
          <entry key="emailRedirectAddress" value=""/>

          <!--
            Not mail, but the same merge: log every provisioning
            transaction, not only failures. Values are the enum
            sailpoint.object.ProvisioningTransaction$Level (Success, Retry,
            Failure); the stock default "Failure" leaves the Provisioning
            Transactions page empty after a perfectly good run, and the
            page is exactly where a developer looks first when an account
            did not appear.
          -->
          <entry key="provisioningTransactionLogLevel" value="Success"/>
        </Map>
      </Attributes>
    </Configuration>
  </ImportAction>

</sailpoint>
