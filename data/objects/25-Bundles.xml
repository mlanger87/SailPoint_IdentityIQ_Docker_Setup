<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  ===========================================================================
  Role model
  ===========================================================================
  Built on the usual two-tier pattern:

    Business role (business)    describes a function in the company,
                                assigned automatically
        requires
    IT role (it)                bundles concrete entitlements of one
                                target system

  Why two tiers instead of entitlements directly on the business role:
  the business role stays independent of the target system. When a
  second system is added later, another IT role is added without touching
  the business definition.

  Assignment runs via "selector", a filter on identity attributes that
  originate from the HR CSV. The task "Refresh Identity Cube" evaluates
  these rules.

  IMPORTANT: every MatchTerm needs type="IdentityAttribute". Without it
  IIQ evaluates the term as an entitlement; the selector then never
  matches, without any error message.

  EQUALLY IMPORTANT: a MatchExpression without and="true" ORs its terms.
  "department=IT" plus "hrStatus=active" without the flag matched 90
  identities (everyone active) instead of the 18 IT people. Nested
  conditions use a MatchTerm with container="true" and child MatchTerms;
  and="false" on the container makes those children an OR group.

  EQUALLY IMPORTANT: the role type must be "business", not
  "organization". The latter maps to the type "organizational", which
  according to ObjectConfig:Bundle carries noAssignmentSelector="true"
  and noAutoAssignment="true": it cannot have a selector at all and is
  never assigned automatically. The import accepts the type without
  complaint nonetheless.

  The assignable types are shown by:
      get ObjectConfig Bundle

  A note on effect: with provision=true in the refresh task IIQ creates
  the LDAP account as soon as a role is assigned and the employee has no
  account yet. That is exactly the joiner case.
  ===========================================================================
-->
<sailpoint>

  <!-- ===================================================================
       IT roles: bundle the LDAP groups
       =================================================================== -->

  <Bundle displayName="LDAP Basic Access" name="ldap-basic-access" type="it">
    <Description>Basic entitlements every person in the company receives.</Description>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
    <Profiles>
      <Profile>
        <ApplicationRef>
          <Reference class="sailpoint.object.Application" name="LDAP-Target"/>
        </ApplicationRef>
        <Constraints>
          <Filter operation="CONTAINS_ALL" property="groups">
            <Value>
              <List>
                <String>cn=org-all-staff,ou=groups,dc=example,dc=com</String>
                <String>cn=app-licence-office,ou=groups,dc=example,dc=com</String>
                <String>cn=app-timesheet,ou=groups,dc=example,dc=com</String>
                <String>cn=app-wiki-read,ou=groups,dc=example,dc=com</String>
              </List>
            </Value>
          </Filter>
        </Constraints>
      </Profile>
    </Profiles>
  </Bundle>

  <Bundle displayName="LDAP IT Access" name="ldap-it-access" type="it">
    <Description>Additional entitlements for the IT department.</Description>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
    <Profiles>
      <Profile>
        <ApplicationRef>
          <Reference class="sailpoint.object.Application" name="LDAP-Target"/>
        </ApplicationRef>
        <Constraints>
          <Filter operation="CONTAINS_ALL" property="groups">
            <Value>
              <List>
                <String>cn=dept-it,ou=groups,dc=example,dc=com</String>
                <String>cn=app-source-control,ou=groups,dc=example,dc=com</String>
                <String>cn=app-ticketing,ou=groups,dc=example,dc=com</String>
                <String>cn=app-vpn,ou=groups,dc=example,dc=com</String>
              </List>
            </Value>
          </Filter>
        </Constraints>
      </Profile>
    </Profiles>
  </Bundle>

  <Bundle displayName="LDAP Sales Access" name="ldap-sales-access" type="it">
    <Description>Additional entitlements for Sales.</Description>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
    <Profiles>
      <Profile>
        <ApplicationRef>
          <Reference class="sailpoint.object.Application" name="LDAP-Target"/>
        </ApplicationRef>
        <Constraints>
          <Filter operation="CONTAINS_ALL" property="groups">
            <Value>
              <List>
                <String>cn=dept-sales,ou=groups,dc=example,dc=com</String>
                <String>cn=app-crm-read,ou=groups,dc=example,dc=com</String>
                <String>cn=app-crm-write,ou=groups,dc=example,dc=com</String>
                <String>cn=app-customer-portal,ou=groups,dc=example,dc=com</String>
              </List>
            </Value>
          </Filter>
        </Constraints>
      </Profile>
    </Profiles>
  </Bundle>

  <Bundle displayName="LDAP Manager Access" name="ldap-manager-access" type="it">
    <Description>Entitlements for managers.</Description>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
    <Profiles>
      <Profile>
        <ApplicationRef>
          <Reference class="sailpoint.object.Application" name="LDAP-Target"/>
        </ApplicationRef>
        <Constraints>
          <Filter operation="CONTAINS_ALL" property="groups">
            <Value>
              <List>
                <String>cn=org-managers,ou=groups,dc=example,dc=com</String>
                <String>cn=app-expenses,ou=groups,dc=example,dc=com</String>
                <String>cn=app-training-portal,ou=groups,dc=example,dc=com</String>
              </List>
            </Value>
          </Filter>
        </Constraints>
      </Profile>
    </Profiles>
  </Bundle>

  <!-- ===================================================================
       Business roles: assigned automatically
       =================================================================== -->

  <Bundle displayName="Employee" name="employee" type="business">
    <Description>Every active person in the company. Carries the basic entitlements.</Description>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
    <!--
      Assignment rule: everyone with HR status "active". The attribute
      comes from the CSV column status and is defined as searchable in
      23-ObjectConfig-Identity.xml; otherwise this filter would not work.
    -->
    <Selector>
      <IdentitySelector>
        <MatchExpression>
          <MatchTerm name="hrStatus" value="active" type="IdentityAttribute"/>
        </MatchExpression>
      </IdentitySelector>
    </Selector>
    <Requirements>
      <Reference class="sailpoint.object.Bundle" name="ldap-basic-access"/>
    </Requirements>
  </Bundle>

  <Bundle displayName="IT Staff" name="it-staff" type="business">
    <Description>Members of the IT department.</Description>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
    <!--
      and="true" is mandatory here: without it the two terms are ORed
      and every active identity became IT staff (90 instead of 18).
    -->
    <Selector>
      <IdentitySelector>
        <MatchExpression and="true">
          <MatchTerm name="department" value="IT" type="IdentityAttribute"/>
          <MatchTerm name="hrStatus" value="active" type="IdentityAttribute"/>
        </MatchExpression>
      </IdentitySelector>
    </Selector>
    <Requirements>
      <Reference class="sailpoint.object.Bundle" name="ldap-it-access"/>
    </Requirements>
  </Bundle>

  <Bundle displayName="Sales Staff" name="sales-staff" type="business">
    <Description>Members of the Sales department.</Description>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
    <Selector>
      <IdentitySelector>
        <MatchExpression and="true">
          <MatchTerm name="department" value="Sales" type="IdentityAttribute"/>
          <MatchTerm name="hrStatus" value="active" type="IdentityAttribute"/>
        </MatchExpression>
      </IdentitySelector>
    </Selector>
    <Requirements>
      <Reference class="sailpoint.object.Bundle" name="ldap-sales-access"/>
    </Requirements>
  </Bundle>

  <!--
    Managers: active AND (department-head OR team-lead). The OR is a
    container term with and="false"; the outer expression ANDs it with
    the status term. Without this role ldap-manager-access was required
    by nothing and never assigned.
  -->
  <Bundle displayName="Manager" name="manager" type="business">
    <Description>Department heads and team leads. Carries the manager entitlements.</Description>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
    <Selector>
      <IdentitySelector>
        <MatchExpression and="true">
          <MatchTerm name="hrStatus" value="active" type="IdentityAttribute"/>
          <MatchTerm container="true" and="false" type="IdentityAttribute">
            <MatchTerm name="employeeType" value="department-head" type="IdentityAttribute"/>
            <MatchTerm name="employeeType" value="team-lead" type="IdentityAttribute"/>
          </MatchTerm>
        </MatchExpression>
      </IdentitySelector>
    </Selector>
    <Requirements>
      <Reference class="sailpoint.object.Bundle" name="ldap-manager-access"/>
    </Requirements>
  </Bundle>

</sailpoint>
