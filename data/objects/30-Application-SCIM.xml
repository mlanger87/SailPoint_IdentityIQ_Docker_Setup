<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  ===========================================================================
  SCIM application: third target system
  ===========================================================================
  Talks to the container "scim" (docker/scim/app.py, RFC 7643/7644).

  The connector comes from connector-bundle-webservices.jar and is loaded
  through the OpenConnectorAdapter. One peculiarity:

      Class.forName("openconnector.connector.scim2.SCIM2Connector")

  fails with ClassNotFoundException although the class is in the bundle.
  The adapter uses its own class loader; a test via the normal classpath
  bypasses it and proves nothing. The only reliable check is a real
  connection test.

  The structure follows an export from an 8.5 instance. Deviations:

    - host points to the container on the Docker network
      (http://scim:8000) instead of a placeholder.
    - Credentials in clear text instead of encrypted (1:ACP:...). The
      encrypted value would be bound to the keystore of the source
      instance and worthless here; see CLAUDE.md.
    - The account schema is filled in. The export carried an empty
      schema (only nativeObjectType="User") because the attributes were
      meant to be fetched from the server via DISCOVER_SCHEMA.

  The server uses bearer token authentication: authType="oauthBearer".
  The "basic" from the export does not match it.
  ===========================================================================
-->
<sailpoint>

  <CorrelationConfig name="SCIM Correlation">
    <AttributeAssignments>
      <Filter operation="EQ" property="employeeNumber" value="externalId"/>
    </AttributeAssignments>
  </CorrelationConfig>

  <Application connector="sailpoint.connector.OpenConnectorAdapter"
               featuresString="DISCOVER_SCHEMA, PROVISIONING, SYNC_PROVISIONING, ENABLE, SEARCH, ACCOUNT_ONLY_REQUEST"
               icon="internetIcon"
               name="SCIM-Target"
               profileClass=""
               type="SCIM 2.0">

    <AccountCorrelationConfig>
      <Reference class="sailpoint.object.CorrelationConfig"
                 name="SCIM Correlation"/>
    </AccountCorrelationConfig>

    <Attributes>
      <Map>
        <entry key="connectorClass"
               value="openconnector.connector.scim2.SCIM2Connector"/>
        <entry key="host" value="http://scim:8000"/>

        <!--
          The server expects "Authorization: Bearer <token>".

          The correct value is "oauthBearer", a static token. Not
          "oauth2": that corresponds to the constant OAuth2Login and
          expects a full token flow with token_url, user and password.
          With the wrong value the server answers 401 invalidCredentials.

          The valid values are in the bundle's constants:
            javap -p -constants openconnector/connector/scim2/SCIM2Constants.class
              AUTH_TYPE_BASIC              = "Basic"
              AUTH_TYPE_BEARER             = "oauthBearer"
              AUTH_TYPE_OAUTH2             = "OAuth2Login"
              AUTH_TYPE_NO_AUTHENTICATION  = "No Auth"
        -->
        <entry key="authType" value="oauthBearer"/>
        <entry key="oauthBearerToken" value="secret"/>

        <entry key="contentType" value="application/scim+json"/>
        <entry key="accept" value="application/scim+json"/>

        <entry key="load-by-sysclassloader">
          <value>
            <List>
              <String>json.jar</String>
            </List>
          </value>
        </entry>

        <!--
          Requests exactly the schema's attributes (?attributes=...).
          Without this switch the connector fetches a default set in
          which externalId is MISSING; correlation then does not match,
          and IIQ creates a separate identity for every account instead
          of assigning it to the existing one.
        -->
        <entry key="explicitAttributesRequest">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>
        <entry key="relaxConfiguration">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>
        <!--
          Group membership is provisioned by patching the group's members
          (PATCH /Groups/{id}), which is what modifyGroups() in the
          connector does. skipGrpUpdate=true (the value an 8.5 UI export
          carries) skips exactly that: entitlements assigned by a role
          would never reach the server, while the plan reports Success.
        -->
        <entry key="skipGrpUpdate">
          <value>
            <Boolean>false</Boolean>
          </value>
        </entry>

        <entry key="encrypted"
               value="client_secret,oauthBearerToken,oauthTokenInfo,refresh_token,private_key,private_key_password,additional_payload,oauth2password"/>

        <entry key="templateApplication" value="SCIM 2.0"/>
        <entry key="sysDescriptions">
          <value>
            <Map>
              <entry key="en_US" value="SCIM 2.0 target system"/>
            </Map>
          </value>
        </entry>
      </Map>
    </Attributes>

    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>

    <!--
      Create policy: without it a role-driven create has only the
      entitlement in the plan; userName is required by the server (400)
      and externalId is the correlation key - the account would exist
      but never match its identity on the next aggregation. The dotted
      names are the schema attribute names; the connector maps them to
      the nested JSON (name.givenName -> {"name": {"givenName": ...}}).
    -->
    <ProvisioningForms>
      <Form name="Create Account" objectType="account" type="Create">
        <Attributes>
          <Map>
            <entry key="pageTitle" value="Create Account"/>
          </Map>
        </Attributes>
        <Section name="Account">
          <Field name="externalId" required="true" type="string">
            <Script>
              <Source><![CDATA[
                return identity.getStringAttribute("employeeNumber");
              ]]></Source>
            </Script>
          </Field>
          <Field name="userName" required="true" type="string">
            <Script>
              <Source><![CDATA[
                // Same rule as the seed users: local part of the mail
                // address, which the generator keeps unique.
                String mail = identity.getEmail();
                if (mail != null && mail.indexOf("@") > 0) {
                    return mail.substring(0, mail.indexOf("@"));
                }
                return identity.getName().toLowerCase();
              ]]></Source>
            </Script>
          </Field>
          <Field name="name.givenName" type="string">
            <Script>
              <Source><![CDATA[return identity.getFirstname();]]></Source>
            </Script>
          </Field>
          <Field name="name.familyName" type="string">
            <Script>
              <Source><![CDATA[return identity.getLastname();]]></Source>
            </Script>
          </Field>
          <Field name="displayName" type="string">
            <Script>
              <Source><![CDATA[return identity.getDisplayableName();]]></Source>
            </Script>
          </Field>
          <Field name="emails.value" type="string">
            <Script>
              <Source><![CDATA[return identity.getEmail();]]></Source>
            </Script>
          </Field>
          <Field name="title" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("jobTitle");]]></Source>
            </Script>
          </Field>
          <Field name="active" type="boolean" value="true"/>
        </Section>
      </Form>
    </ProvisioningForms>

    <Schemas>
      <!--
        externalId carries the employee number and is therefore the
        correlation key; id is a server-assigned UUID and unsuitable
        because it is still unknown at create time.

        identityAttribute nevertheless stays id: that is the native
        identifier the connector uses to address an entry.
      -->
      <Schema displayAttribute="userName"
              identityAttribute="id"
              instanceAttribute=""
              nativeObjectType="User"
              objectType="account">
        <AttributeDefinition name="id" type="string">
          <Description>Server-assigned identifier (UUID)</Description>
        </AttributeDefinition>
        <AttributeDefinition name="externalId" type="string">
          <Description>Employee number, the correlation key</Description>
        </AttributeDefinition>
        <AttributeDefinition name="userName" type="string">
          <Description>Login name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="displayName" type="string">
          <Description>Display name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="name.givenName" type="string">
          <Description>First name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="name.familyName" type="string">
          <Description>Last name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="emails.value" type="string">
          <Description>E-mail address</Description>
        </AttributeDefinition>
        <AttributeDefinition name="title" type="string">
          <Description>Job title</Description>
        </AttributeDefinition>
        <AttributeDefinition name="active" type="boolean">
          <Description>Active or disabled</Description>
        </AttributeDefinition>
        <AttributeDefinition entitlement="true" managed="true" multi="true"
                             name="groups" schemaObjectType="group"
                             type="string">
          <Description>Group memberships</Description>
        </AttributeDefinition>
      </Schema>

      <Schema displayAttribute="displayName"
              identityAttribute="id"
              instanceAttribute=""
              nativeObjectType="Group"
              objectType="group">
        <AttributeDefinition name="id" type="string">
          <Description>Group identifier</Description>
        </AttributeDefinition>
        <AttributeDefinition name="displayName" type="string">
          <Description>Group name</Description>
        </AttributeDefinition>
      </Schema>
    </Schemas>

  </Application>

  <TaskDefinition name="SCIM Aggregation"
                  executor="sailpoint.task.ResourceIdentityScan"
                  progressMode="Percentage"
                  resultAction="Delete"
                  type="AccountAggregation">
    <Description>Reads the accounts of the SCIM target system and correlates them via externalId.</Description>
    <Parent>
      <Reference class="sailpoint.object.TaskDefinition" name="Account Aggregation"/>
    </Parent>
    <Attributes>
      <Map>
        <entry key="applications" value="SCIM-Target"/>
        <!--
          A target keeps accounts that were deleted natively unless this is
          set; the stock template leaves it false. Measured: 85 entries removed
          from the directory, aggregation "Success", 90 links still there.
        -->
        <entry key="checkDeleted">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>
        <entry key="correlateEntitlements">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>
      </Map>
    </Attributes>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
  </TaskDefinition>

  <!--
    Groups before accounts, as with LDAP: the account aggregation turns
    groups into entitlements, and only an aggregated group gives
    them a display name.
  -->
  <TaskDefinition name="SCIM Group Aggregation"
                  executor="sailpoint.task.ResourceIdentityScan"
                  progressMode="Percentage"
                  resultAction="Delete"
                  type="AccountGroupAggregation">
    <Description>Reads the groups of the SCIM target system as entitlements.</Description>
    <Parent>
      <Reference class="sailpoint.object.TaskDefinition" name="Account Group Aggregation"/>
    </Parent>
    <Attributes>
      <Map>
        <entry key="applications" value="SCIM-Target"/>
        <entry key="aggregationType" value="group"/>
        <entry key="checkDeleted">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>
      </Map>
    </Attributes>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
  </TaskDefinition>

</sailpoint>
