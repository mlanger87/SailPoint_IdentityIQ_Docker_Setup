<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  ===========================================================================
  Web Services application: fourth target system
  ===========================================================================
  Talks to the mock REST API in the container "mockapi". Unlike the SCIM
  connector, which presupposes a fixed protocol, here EVERY endpoint is
  described individually; that is the usual case with in-house APIs.

  The valid values come from the shipped form definition
  WEB-INF/config/connector/WebServices.xml, not from examples:

    authenticationMethod
        BasicLogin    user and password
        OAuthLogin    API token (used here)
        OAuth2Login   full OAuth 2 flow
        No Auth       none or custom authentication

    operationType
        Test Connection, Account Aggregation,
        Account Delta Aggregation, Group Aggregation,
        Get Object, Get Object-Group,
        Create Account, Update Account, Delete Account,
        Enable Account, Disable Account,
        Add Entitlement, Remove Entitlement

  Layout: genericWebServiceBaseUrl sets the base, each entry in
  connectionParameters describes one endpoint relative to it.

  The places where such integrations typically fail:

    1. rootPath: the API returns the records under "data", not at top
       level. The entry belongs on the ENDPOINT level (in the UI: menu
       "Response Information"), NOT inside the resMappingObj map. Nested
       wrongly, the aggregation reports Success and processes zero
       records.

    2. Paging: this API uses offset/limit, others page/size or a cursor.
       Without the configuration the connector reads only the first page
       and still reports success.

    3. $plan.* / $response.*: the placeholders through which values reach
       the body. A placeholder that resolves to nothing is left in place
       and the connector then drops the WHOLE body, not just the field.

    4. The body text always sits under the key jsonBody; bodyFormat is
       "raw" or "formData" (see the form config/connector/WebServices.xml).
       There is no rawBody: such an entry is ignored without a message
       and the request is sent with no body at all. Measured as
       "Missing required field: login" on every create while the plan
       carried the value; only the connector trace log (payload=null)
       showed why. bodyFormat="json" does not exist either - the facade
       initialization aborts with a bare ConnectorException.
  ===========================================================================
-->
<sailpoint>

  <CorrelationConfig name="WebService Correlation">
    <AttributeAssignments>
      <Filter operation="EQ" property="employeeNumber" value="employeeId"/>
    </AttributeAssignments>
  </CorrelationConfig>

  <Application connector="sailpoint.connector.webservices.WebServicesConnector"
               featuresString="PROVISIONING, ENABLE, SEARCH, ACCOUNT_ONLY_REQUEST"
               icon="internetIcon"
               name="WebService-Target"
               profileClass=""
               type="Web Services">

    <AccountCorrelationConfig>
      <Reference class="sailpoint.object.CorrelationConfig"
                 name="WebService Correlation"/>
    </AccountCorrelationConfig>

    <Attributes>
      <Map>
        <!--
          The list of attributes IIQ stores encrypted. Every UI export
          carries it; hand-written applications tend to omit it, and
          then any endpoint with a jsonBody dies before the first
          request: the connector does encryptedList.add("password") on
          the parsed list, and Util.csvToList(null) returns an immutable
          empty list -> UnsupportedOperationException, surfaced as a bare
          ConnectorException (measured; only the trace log names
          getSortedEndPointsForV2). Any non-empty value works.
        -->
        <entry key="encrypted" value="password,accesstoken,refresh_token,client_secret,private_key,private_key_password,oauth_token_info"/>
        <entry key="genericWebServiceBaseUrl" value="http://mockapi:8000"/>

        <!--
          OAuthLogin here means: static API token in the Authorization
          header. Not to be confused with OAuth2Login, which expects a
          token flow with token_url.
        -->
        <entry key="authenticationMethod" value="OAuthLogin"/>
        <entry key="accesstoken" value="mocktoken"/>

        <entry key="timeoutInSeconds" value="30"/>
        <entry key="disableCookies">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>

        <!--
          =================================================================
          The endpoints
          =================================================================
        -->
        <entry key="connectionParameters">
          <value>
            <List>

              <!-- ===================================================
                   Connection test
                   ===================================================
                   Uses /health, which deliberately needs no token: this
                   distinguishes "service unreachable" from "login
                   fails".
              -->
              <Map>
                <entry key="operationType" value="Test Connection"/>
                <entry key="uniqueNameForEndPoint" value="TestConnection"/>
                <entry key="contextUrl" value="/api/v1/health"/>
                <entry key="httpMethodType" value="GET"/>
                <entry key="header">
                  <value>
                    <Map>
                      <entry key="Accept" value="application/json"/>
                    </Map>
                  </value>
                </entry>
                <entry key="responseCode">
                  <value>
                    <List>
                      <Integer>200</Integer>
                    </List>
                  </value>
                </entry>
              </Map>

              <!-- ===================================================
                   Account aggregation with paging
                   ===================================================
                   rootPath points to "data", where the records are.
                   Paging runs via offset/limit; the connector increments
                   offset itself as long as records keep coming back.
              -->
              <Map>
                <entry key="operationType" value="Account Aggregation"/>
                <entry key="uniqueNameForEndPoint" value="AccountAggregation"/>
                <entry key="contextUrl" value="/api/v1/users"/>
                <entry key="httpMethodType" value="GET"/>
                <entry key="header">
                  <value>
                    <Map>
                      <entry key="Accept" value="application/json"/>
                    </Map>
                  </value>
                </entry>
                <entry key="responseCode">
                  <value>
                    <List>
                      <Integer>200</Integer>
                    </List>
                  </value>
                </entry>
                <entry key="rootPath" value="data"/>
                <entry key="resMappingObj">
                  <value>
                    <Map>
                      <entry key="nativeIdentity" value="id"/>
                      <!--
                        id must be mapped in addition: the schema has
                        identityAttribute="id", and the connector looks
                        for exactly that name in the generated map.
                        nativeIdentity alone is not enough; the
                        aggregation then reports Success and processes
                        zero records.

                        With the group schema this does not show because
                        there identityAttribute="name" and "name" is in
                        the mapping anyway.
                      -->
                      <entry key="id" value="id"/>
                      <entry key="employeeId" value="employeeId"/>
                      <entry key="login" value="login"/>
                      <entry key="firstName" value="firstName"/>
                      <entry key="lastName" value="lastName"/>
                      <entry key="fullName" value="fullName"/>
                      <entry key="email" value="email"/>
                      <entry key="jobTitle" value="jobTitle"/>
                      <entry key="department" value="department"/>
                      <entry key="office" value="office"/>
                      <entry key="status" value="status"/>
                      <!-- boolean from the API; IIQDisabled cannot be derived from a string -->
                      <entry key="IIQDisabled" value="disabled"/>
                      <entry key="roles" value="roles"/>
                    </Map>
                  </value>
                </entry>
                <!--
                  NO paging configured, deliberately.

                  According to the form definition paginationSteps is a
                  textarea, i.e. a URL fragment with placeholders, not a
                  keyword. A bare "offset" is not recognized as paging:
                  the connector then calls the same endpoint without
                  parameters over and over and never stops. Measured:
                  11,943 requests until the task was terminated by hand.

                  For the data volume of this environment paging is
                  unnecessary anyway; the API returns up to 200 records
                  in one go. If needed, configure it in the UI
                  (Application > Settings > Paging) and export the
                  generated fragment.
                -->
              </Map>

              <!-- ===================================================
                   Group aggregation: the entitlements
                   =================================================== -->
              <Map>
                <entry key="operationType" value="Group Aggregation"/>
                <entry key="uniqueNameForEndPoint" value="GroupAggregation"/>
                <entry key="contextUrl" value="/api/v1/groups"/>
                <entry key="httpMethodType" value="GET"/>
                <entry key="header">
                  <value>
                    <Map>
                      <entry key="Accept" value="application/json"/>
                    </Map>
                  </value>
                </entry>
                <entry key="responseCode">
                  <value>
                    <List>
                      <Integer>200</Integer>
                    </List>
                  </value>
                </entry>
                <entry key="rootPath" value="data"/>
                <entry key="resMappingObj">
                  <value>
                    <Map>
                      <entry key="nativeIdentity" value="name"/>
                      <entry key="name" value="name"/>
                      <entry key="description" value="description"/>
                    </Map>
                  </value>
                </entry>
              </Map>

              <!-- ===================================================
                   Single fetch after provisioning
                   ===================================================
                   The connector substitutes $plan.nativeIdentity$ with
                   the identifier of the affected account.
              -->
              <Map>
                <entry key="operationType" value="Get Object"/>
                <entry key="uniqueNameForEndPoint" value="GetObject"/>
                <entry key="contextUrl" value="/api/v1/users/$plan.nativeIdentity$"/>
                <entry key="httpMethodType" value="GET"/>
                <entry key="header">
                  <value>
                    <Map>
                      <entry key="Accept" value="application/json"/>
                    </Map>
                  </value>
                </entry>
                <entry key="responseCode">
                  <value>
                    <List>
                      <Integer>200</Integer>
                    </List>
                  </value>
                </entry>
                <!--
                  Same mapping as the aggregation, including id: the
                  single fetch feeds the same schema, and a partial map
                  would wipe the unmapped attributes from the link.
                -->
                <entry key="resMappingObj">
                  <value>
                    <Map>
                      <entry key="nativeIdentity" value="id"/>
                      <entry key="id" value="id"/>
                      <entry key="employeeId" value="employeeId"/>
                      <entry key="login" value="login"/>
                      <entry key="firstName" value="firstName"/>
                      <entry key="lastName" value="lastName"/>
                      <entry key="fullName" value="fullName"/>
                      <entry key="email" value="email"/>
                      <entry key="jobTitle" value="jobTitle"/>
                      <entry key="department" value="department"/>
                      <entry key="office" value="office"/>
                      <entry key="status" value="status"/>
                      <!-- boolean from the API; IIQDisabled cannot be derived from a string -->
                      <entry key="IIQDisabled" value="disabled"/>
                      <entry key="roles" value="roles"/>
                    </Map>
                  </value>
                </entry>
              </Map>

              <!-- ===================================================
                   Create account
                   ===================================================
                   The $plan.*$ placeholders are filled from the
                   ProvisioningPlan. The names must match the attributes
                   of the create policy exactly; a typo goes unnoticed,
                   the field silently stays empty.
              -->
              <Map>
                <entry key="operationType" value="Create Account"/>
                <entry key="uniqueNameForEndPoint" value="CreateAccount"/>
                <entry key="contextUrl" value="/api/v1/users"/>
                <entry key="httpMethodType" value="POST"/>
                <entry key="header">
                  <value>
                    <Map>
                      <entry key="Content-Type" value="application/json"/>
                      <entry key="Accept" value="application/json"/>
                    </Map>
                  </value>
                </entry>
                <entry key="body">
                  <value>
                    <Map>
                      <entry key="bodyFormat" value="raw"/>
                      <entry key="jsonBody">
                        <value>
                          <String><![CDATA[{
  "login": "$plan.login$",
  "employeeId": "$plan.employeeId$",
  "firstName": "$plan.firstName$",
  "lastName": "$plan.lastName$",
  "fullName": "$plan.fullName$",
  "email": "$plan.email$",
  "jobTitle": "$plan.jobTitle$",
  "department": "$plan.department$",
  "office": "$plan.office$",
  "status": "ACTIVE"
}]]></String>
                        </value>
                      </entry>
                    </Map>
                  </value>
                </entry>
                <entry key="responseCode">
                  <value>
                    <List>
                      <Integer>201</Integer>
                      <Integer>200</Integer>
                    </List>
                  </value>
                </entry>
                <!--
                  The response mapping must name the schema's
                  identityAttribute by its own name (id -> id), exactly
                  as in the aggregation mapping. With nativeIdentity
                  alone the connector logs (trace only) "Native identity
                  is neither present in the plan nor in the response",
                  reports the create as committed and silently skips the
                  Add Entitlement calls that follow a create - measured:
                  nine HR accounts created, none with a role.
                -->
                <entry key="resMappingObj">
                  <value>
                    <Map>
                      <entry key="id" value="id"/>
                      <entry key="nativeIdentity" value="id"/>
                    </Map>
                  </value>
                </entry>
              </Map>

              <!-- ===================================================
                   Update account: scalar attributes only
                   ===================================================
                   Roles are NOT in this body. A PATCH with
                   {"roles": [...]} replaces the whole list, so a single
                   role removal would have wiped every other role. The
                   deltas go through the two entitlement endpoints below.

                   Known connector behaviour: a $plan.x$ placeholder for
                   an attribute absent from the plan renders as an empty
                   string, so an update that changes only jobTitle sends
                   the other three fields empty. Acceptable for the mock;
                   a real API would want one endpoint per attribute or a
                   before-provisioning rule that trims the body.
              -->
              <Map>
                <entry key="operationType" value="Update Account"/>
                <entry key="uniqueNameForEndPoint" value="UpdateAccount"/>
                <entry key="contextUrl" value="/api/v1/users/$plan.nativeIdentity$"/>
                <entry key="httpMethodType" value="PATCH"/>
                <entry key="header">
                  <value>
                    <Map>
                      <entry key="Content-Type" value="application/json"/>
                      <entry key="Accept" value="application/json"/>
                    </Map>
                  </value>
                </entry>
                <entry key="body">
                  <value>
                    <Map>
                      <entry key="bodyFormat" value="raw"/>
                      <entry key="jsonBody">
                        <value>
                          <String><![CDATA[{
  "jobTitle": "$plan.jobTitle$",
  "department": "$plan.department$",
  "office": "$plan.office$",
  "email": "$plan.email$"
}]]></String>
                        </value>
                      </entry>
                    </Map>
                  </value>
                </entry>
                <entry key="responseCode">
                  <value>
                    <List>
                      <Integer>200</Integer>
                    </List>
                  </value>
                </entry>
              </Map>

              <!-- ===================================================
                   Entitlement deltas: one call per role
                   ===================================================
                   The connector splits an AttributeRequest on "roles"
                   into one call per value; $plan.roles$ then carries a
                   single role name. The mock implements both routes.
              -->
              <Map>
                <entry key="operationType" value="Add Entitlement"/>
                <entry key="uniqueNameForEndPoint" value="AddEntitlement"/>
                <entry key="contextUrl" value="/api/v1/users/$plan.nativeIdentity$/roles"/>
                <entry key="httpMethodType" value="POST"/>
                <entry key="header">
                  <value>
                    <Map>
                      <entry key="Content-Type" value="application/json"/>
                      <entry key="Accept" value="application/json"/>
                    </Map>
                  </value>
                </entry>
                <entry key="body">
                  <value>
                    <Map>
                      <entry key="bodyFormat" value="raw"/>
                      <entry key="jsonBody">
                        <value>
                          <String><![CDATA[{"role": "$plan.roles$"}]]></String>
                        </value>
                      </entry>
                    </Map>
                  </value>
                </entry>
                <entry key="responseCode">
                  <value>
                    <List>
                      <Integer>200</Integer>
                    </List>
                  </value>
                </entry>
              </Map>

              <Map>
                <entry key="operationType" value="Remove Entitlement"/>
                <entry key="uniqueNameForEndPoint" value="RemoveEntitlement"/>
                <entry key="contextUrl" value="/api/v1/users/$plan.nativeIdentity$/roles/$plan.roles$"/>
                <entry key="httpMethodType" value="DELETE"/>
                <entry key="header">
                  <value>
                    <Map>
                      <entry key="Accept" value="application/json"/>
                    </Map>
                  </value>
                </entry>
                <entry key="responseCode">
                  <value>
                    <List>
                      <Integer>200</Integer>
                    </List>
                  </value>
                </entry>
              </Map>

              <!-- ===================================================
                   Disable account instead of deleting it
                   ===================================================
                   As with the JDBC target system: the data is retained
                   for audit reasons, only the status changes.
              -->
              <Map>
                <entry key="operationType" value="Disable Account"/>
                <entry key="uniqueNameForEndPoint" value="DisableAccount"/>
                <entry key="contextUrl" value="/api/v1/users/$plan.nativeIdentity$"/>
                <entry key="httpMethodType" value="PATCH"/>
                <entry key="header">
                  <value>
                    <Map>
                      <entry key="Content-Type" value="application/json"/>
                      <entry key="Accept" value="application/json"/>
                    </Map>
                  </value>
                </entry>
                <entry key="body">
                  <value>
                    <Map>
                      <entry key="bodyFormat" value="raw"/>
                      <entry key="jsonBody">
                        <value>
                          <String><![CDATA[{"status": "DISABLED"}]]></String>
                        </value>
                      </entry>
                    </Map>
                  </value>
                </entry>
                <entry key="responseCode">
                  <value>
                    <List>
                      <Integer>200</Integer>
                    </List>
                  </value>
                </entry>
              </Map>

              <Map>
                <entry key="operationType" value="Enable Account"/>
                <entry key="uniqueNameForEndPoint" value="EnableAccount"/>
                <entry key="contextUrl" value="/api/v1/users/$plan.nativeIdentity$"/>
                <entry key="httpMethodType" value="PATCH"/>
                <entry key="header">
                  <value>
                    <Map>
                      <entry key="Content-Type" value="application/json"/>
                      <entry key="Accept" value="application/json"/>
                    </Map>
                  </value>
                </entry>
                <entry key="body">
                  <value>
                    <Map>
                      <entry key="bodyFormat" value="raw"/>
                      <entry key="jsonBody">
                        <value>
                          <String><![CDATA[{"status": "ACTIVE"}]]></String>
                        </value>
                      </entry>
                    </Map>
                  </value>
                </entry>
                <entry key="responseCode">
                  <value>
                    <List>
                      <Integer>200</Integer>
                    </List>
                  </value>
                </entry>
              </Map>

              <!-- ===================================================
                   Delete account
                   ===================================================
                   Defined but not used by the leaver workflow, which
                   disables instead. Present so the case can be tested
                   when needed.
              -->
              <Map>
                <entry key="operationType" value="Delete Account"/>
                <entry key="uniqueNameForEndPoint" value="DeleteAccount"/>
                <entry key="contextUrl" value="/api/v1/users/$plan.nativeIdentity$"/>
                <entry key="httpMethodType" value="DELETE"/>
                <entry key="header">
                  <value>
                    <Map>
                      <entry key="Accept" value="application/json"/>
                    </Map>
                  </value>
                </entry>
                <entry key="responseCode">
                  <value>
                    <List>
                      <Integer>204</Integer>
                      <Integer>200</Integer>
                    </List>
                  </value>
                </entry>
              </Map>

            </List>
          </value>
        </entry>

        <entry key="templateApplication" value="Web Services"/>
        <entry key="sysDescriptions">
          <value>
            <Map>
              <entry key="en_US" value="REST API target system (generic web services)"/>
            </Map>
          </value>
        </entry>
      </Map>
    </Attributes>

    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>

    <ProvisioningForms>
      <Form name="Create Account" objectType="account" type="Create">
        <Attributes>
          <Map>
            <entry key="pageTitle" value="Create Account"/>
          </Map>
        </Attributes>
        <Section name="Account">
          <Field name="employeeId" required="true" type="string">
            <Script>
              <Source><![CDATA[
                return identity.getStringAttribute("employeeNumber");
              ]]></Source>
            </Script>
          </Field>
          <Field name="login" required="true" type="string">
            <Script>
              <Source><![CDATA[
                // Login name from the e-mail address, the same pattern as
                // the existing accounts, so that created and pre-existing
                // accounts look alike.
                String mail = identity.getEmail();
                if (mail != null && mail.indexOf("@") > 0) {
                    return mail.substring(0, mail.indexOf("@"));
                }
                return identity.getName().toLowerCase();
              ]]></Source>
            </Script>
          </Field>
          <Field name="firstName" type="string">
            <Script>
              <Source><![CDATA[return identity.getFirstname();]]></Source>
            </Script>
          </Field>
          <Field name="lastName" type="string">
            <Script>
              <Source><![CDATA[return identity.getLastname();]]></Source>
            </Script>
          </Field>
          <Field name="fullName" type="string">
            <Script>
              <Source><![CDATA[return identity.getDisplayableName();]]></Source>
            </Script>
          </Field>
          <Field name="email" type="string">
            <Script>
              <Source><![CDATA[return identity.getEmail();]]></Source>
            </Script>
          </Field>
          <Field name="jobTitle" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("jobTitle");]]></Source>
            </Script>
          </Field>
          <Field name="department" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("department");]]></Source>
            </Script>
          </Field>
          <Field name="office" type="string">
            <Script>
              <Source><![CDATA[return identity.getStringAttribute("location");]]></Source>
            </Script>
          </Field>
        </Section>
      </Form>
    </ProvisioningForms>

    <Schemas>
      <!--
        nativeIdentity is the server-assigned UUID (id) because the
        connector addresses accounts by it. Correlation, however, runs on
        employeeId; the UUID is still unknown at create time.
      -->
      <Schema displayAttribute="fullName"
              identityAttribute="id"
              instanceAttribute=""
              nativeObjectType="account"
              objectType="account">
        <AttributeDefinition name="id" type="string">
          <Description>Identifier assigned by the target system</Description>
        </AttributeDefinition>
        <AttributeDefinition name="employeeId" type="string">
          <Description>Employee number, the correlation key</Description>
        </AttributeDefinition>
        <AttributeDefinition name="login" type="string">
          <Description>Login name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="firstName" type="string">
          <Description>First name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="lastName" type="string">
          <Description>Last name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="fullName" type="string">
          <Description>Display name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="email" type="string">
          <Description>E-mail address</Description>
        </AttributeDefinition>
        <AttributeDefinition name="jobTitle" type="string">
          <Description>Job title</Description>
        </AttributeDefinition>
        <AttributeDefinition name="department" type="string">
          <Description>Department</Description>
        </AttributeDefinition>
        <AttributeDefinition name="office" type="string">
          <Description>Location</Description>
        </AttributeDefinition>
        <AttributeDefinition name="status" type="string">
          <Description>ACTIVE or DISABLED</Description>
        </AttributeDefinition>
        <AttributeDefinition entitlement="true" managed="true" multi="true"
                             name="roles" schemaObjectType="group" type="string">
          <Description>Roles in the target system</Description>
        </AttributeDefinition>
      </Schema>

      <Schema displayAttribute="name"
              identityAttribute="name"
              instanceAttribute=""
              nativeObjectType="group"
              objectType="group">
        <AttributeDefinition name="name" type="string">
          <Description>Role name</Description>
        </AttributeDefinition>
        <AttributeDefinition name="description" type="string">
          <Description>Description</Description>
        </AttributeDefinition>
      </Schema>
    </Schemas>

  </Application>

  <TaskDefinition name="WebService Aggregation"
                  executor="sailpoint.task.ResourceIdentityScan"
                  progressMode="Percentage"
                  resultAction="Delete"
                  type="AccountAggregation">
    <Description>Reads the accounts of the REST API and correlates them via employeeId.</Description>
    <Parent>
      <Reference class="sailpoint.object.TaskDefinition" name="Account Aggregation"/>
    </Parent>
    <Attributes>
      <Map>
        <entry key="applications" value="WebService-Target"/>
        <!--
          A target keeps accounts that were deleted natively unless this is
          set; the stock template leaves it false. Measured: 85 entries removed
          from the directory, aggregation "Success", 90 links still there.
        -->
        <entry key="checkDeleted">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>
        <entry key="correlateEntitlements">
          <value>
            <Boolean>true</Boolean>
          </value>
        </entry>
      </Map>
    </Attributes>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
  </TaskDefinition>

  <TaskDefinition name="WebService Group Aggregation"
                  executor="sailpoint.task.ResourceIdentityScan"
                  progressMode="String"
                  resultAction="Delete"
                  subType="task_item_type_acct_grp_aggregation"
                  type="AccountGroupAggregation">
    <Description>Loads the roles of the REST API as entitlements.</Description>
    <Parent>
      <Reference class="sailpoint.object.TaskDefinition" name="Account Group Aggregation"/>
    </Parent>
    <Attributes>
      <Map>
        <entry key="applications" value="WebService-Target"/>
        <entry key="aggregationType" value="group"/>
      </Map>
    </Attributes>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="spadmin"/>
    </Owner>
  </TaskDefinition>

</sailpoint>
