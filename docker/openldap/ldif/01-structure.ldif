# ===========================================================================
# Base structure of the test directory
# ---------------------------------------------------------------------------
# Base DN: dc=example,dc=com
#
# Loaded on first start of bitnami/openldap (LDAP_CUSTOM_LDIF_DIR=/ldifs).
# Files are processed alphabetically, hence the numeric prefixes.
# ===========================================================================

dn: dc=example,dc=com
objectClass: top
objectClass: dcObject
objectClass: organization
o: Example Corporation
dc: example

dn: ou=people,dc=example,dc=com
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=example,dc=com
objectClass: organizationalUnit
ou: groups

# ---------------------------------------------------------------------------
# Placeholder for empty groups
#
# objectClass groupOfNames requires at least one member per RFC 4519; a
# memberless group violates the schema and slapd rejects it. Since this
# directory is a target system, many groups start out empty, waiting for
# IdentityIQ to put accounts in.
#
# This entry serves as the sole member of such groups. It is deliberately
# NOT under ou=people so it stays out of account aggregation scope
# (searchDN: ou=people).
# ---------------------------------------------------------------------------
dn: cn=placeholder,dc=example,dc=com
objectClass: applicationProcess
objectClass: top
cn: placeholder
description: Placeholder for empty groups - not a real account
