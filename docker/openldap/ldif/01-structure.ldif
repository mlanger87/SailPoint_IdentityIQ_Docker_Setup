# ===========================================================================
# Grundstruktur des Testverzeichnisses
# ---------------------------------------------------------------------------
# Basis-DN: dc=example,dc=com
#
# Wird beim ersten Start von bitnami/openldap eingelesen
# (LDAP_CUSTOM_LDIF_DIR=/ldifs). Die Dateien werden alphabetisch
# verarbeitet, daher die Nummernpraefixe.
#
# Die Daten selbst sind englisch gehalten, wie in realen
# IdentityIQ-Projekten ueblich.
# ===========================================================================

dn: dc=example,dc=com
objectClass: top
objectClass: dcObject
objectClass: organization
o: Example Corporation
dc: example

dn: ou=people,dc=example,dc=com
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=example,dc=com
objectClass: organizationalUnit
ou: groups

# ---------------------------------------------------------------------------
# Platzhalter fuer leere Gruppen
#
# Die objectClass groupOfNames verlangt laut RFC 4519 mindestens ein
# member; eine mitgliederlose Gruppe ist schema-widrig und wird von slapd
# abgelehnt. Da dieses Verzeichnis Zielsystem ist, sind aber viele Gruppen
# zunaechst leer und warten darauf, dass IdentityIQ Accounts hineinlegt.
#
# Dieser Eintrag dient solchen Gruppen als einziges member. Er liegt
# bewusst NICHT unter ou=people, damit er nicht in den Bereich der
# Account-Aggregation faellt (searchDN: ou=people).
# ---------------------------------------------------------------------------
dn: cn=placeholder,dc=example,dc=com
objectClass: applicationProcess
objectClass: top
cn: placeholder
description: Platzhalter fuer leere Gruppen - kein echter Account
