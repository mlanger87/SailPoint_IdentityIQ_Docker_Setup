# ===========================================================================
# SCIM 2.0 server as target system for the SCIM2Connector
# ===========================================================================
# Same construction as the REST mock: standard library only, ~50 MB
# image, no dependency to pin. See docker/scim/app.py for why a
# third-party SCIM server did not do (no derived "groups" on users).
#
# Seed data comes at runtime from data/seed (bind mount), generated by
# scripts/generate-testdata.py from the same person list as every other
# target.
# ===========================================================================
FROM python:3.13-alpine

# Do not run as root - same reasoning as for the IIQ container.
RUN adduser -D -u 1000 scim

WORKDIR /app
COPY --chown=1000:1000 docker/scim/app.py /app/app.py

USER 1000:1000

EXPOSE 8000

# ServiceProviderConfig needs no token, so the healthcheck does not
# depend on it.
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; \
sys.exit(0 if urllib.request.urlopen('http://localhost:8000/ServiceProviderConfig', timeout=3).status==200 else 1)"

CMD ["python", "-u", "/app/app.py"]
