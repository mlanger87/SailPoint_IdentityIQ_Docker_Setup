# ---------------------------------------------------------------------------
# IMPORTANT: shell scripts MUST keep LF line endings.
#
# The host is Windows. With core.autocrlf=true Git would write CRLF on
# checkout. A shell script with a CRLF shebang fails in the Linux
# container with "bad interpreter: No such file or directory".
#
# The reference projects lacked this or had it incomplete (project B
# only covers *.sh, not the extension-less "console").
# ---------------------------------------------------------------------------
* text=auto eol=lf

*.sh            text eol=lf
entrypoint      text eol=lf
healthcheck     text eol=lf
console         text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.properties    text eol=lf
*.tmpl          text eol=lf
*.sql           text eol=lf
*.ldif          text eol=lf

# Windows scripts keep CRLF
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Do not touch binaries
*.zip           binary
*.jar           binary
*.war           binary
*.png           binary
*.jpg           binary
*.pdf           binary
*.dat           binary
