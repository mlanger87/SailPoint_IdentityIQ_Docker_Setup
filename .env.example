# ===========================================================================
# SailPoint IdentityIQ 8.5 - Docker development environment
# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Bash)
#
# .env is excluded via .gitignore and is NOT committed.
# ===========================================================================

# ---------------------------------------------------------------------------
# IdentityIQ
# ---------------------------------------------------------------------------
# Must match the file name in installer/.
IIQ_VERSION=8.5

# Patch level, e.g. "p1". Leave empty if there is no patch JAR.
# The patch JAR then goes to installer/identityiq-8.5p1.jar.
IIQ_PATCH=

# Two IIQ nodes on one database: a UI node and a batch node. The names
# become the Server objects (-Diiq.hostname). The batch node's name is
# what data/objects/05-ServiceDefinitions.xml lists under hosts= for the
# Task and Request services - rename both or neither.
IIQ_NODE=iiq-ui
IIQ_BATCH_NODE=iiq-batch

# JVM heap per node. Two nodes plus PostgreSQL on 16 GB Docker RAM:
# 3g each is comfortable, 4g each is tight.
IIQ_HEAP=3g
IIQ_BATCH_HEAP=3g

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
IIQ_HTTP_PORT=8080
IIQ_BATCH_HTTP_PORT=8081
IIQ_DEBUG_PORT=8000
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
DBGATE_PORT=5050
LDAP_PORT=1389
LDAP_UI_PORT=5080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Superuser - creates the IIQ databases on first start.
POSTGRES_PASSWORD=postgres

# The three IIQ database users.
# CAUTION: these values are baked into SailPoint's DDL at image build.
# After a change, a rebuild is required:
#     docker compose build postgres && docker compose down -v && docker compose up -d
IIQ_DB_USER=identityiq
IIQ_DB_PASSWORD=identityiq

IIQ_PLUGIN_DB_USER=identityiqPlugin
IIQ_PLUGIN_DB_PASSWORD=identityiqPlugin

IIQ_AH_DB_USER=identityiqah
IIQ_AH_DB_PASSWORD=identityiqah

# ---------------------------------------------------------------------------
# OpenLDAP (test directory for aggregation/provisioning)
# ---------------------------------------------------------------------------
LDAP_ROOT=dc=example,dc=com
LDAP_ADMIN_USER=admin
LDAP_ADMIN_PASSWORD=adminpassword

# SCIM server (third target system)
SCIM_PORT=8100
SCIM_API_KEY=secret

# Mock REST API (target system for the Web Services connector)
MOCKAPI_PORT=8200
MOCKAPI_TOKEN=mocktoken
MOCKAPI_USER=iiq
MOCKAPI_PASSWORD=iiqpassword

# Additional JVM options. Appended to CATALINA_OPTS so the development
# override does not have to overwrite the base.
IIQ_EXTRA_OPTS=-Dsailpoint.debugPages=true

# ---------------------------------------------------------------------------
# Values that are ALSO hard-coded elsewhere
# ---------------------------------------------------------------------------
# This file is not the single source for target-system credentials. The
# same defaults are baked into the IIQ application objects and are not
# substituted at import time:
#   LDAP_ADMIN_PASSWORD  -> data/objects/21-Application-LDAP.xml, scripts/verify.sh
#   SCIM_API_KEY         -> data/objects/30-Application-SCIM.xml
#   MOCKAPI_TOKEN        -> data/objects/31-Application-WebService.xml
#   targetapp/targetapp  -> data/objects/27-Application-JDBC.xml,
#                           docker/postgres/03-targetdb.sql, docker-compose.yml (DBGate)
# Change one of them here and the matching XML must change too, or the
# connector answers 401 / authentication failed after the next import.
