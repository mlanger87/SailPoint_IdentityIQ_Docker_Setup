# ===========================================================================
# SailPoint IdentityIQ 8.5 - Docker-Entwicklungsumgebung
# ---------------------------------------------------------------------------
# Diese Datei nach ".env" kopieren und anpassen:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Bash)
#
# Die .env ist per .gitignore ausgeschlossen und wird NICHT eingecheckt.
# ===========================================================================

# ---------------------------------------------------------------------------
# IdentityIQ
# ---------------------------------------------------------------------------
# Muss zum Dateinamen in installer/ passen.
IIQ_VERSION=8.5

# Patch-Level, z.B. "p1". Leer lassen, wenn kein Patch-JAR vorliegt.
# Das Patch-JAR gehoert dann als installer/identityiq-8.5p1.jar abgelegt.
IIQ_PATCH=

# Logischer Servername des IIQ-Nodes (-Diiq.hostname).
# Muss eindeutig sein, sobald mehrere Nodes laufen.
IIQ_NODE=iiq-dev

# JVM-Heap fuer Tomcat. Bei 16 GB Docker-RAM sind 4g komfortabel.
IIQ_HEAP=4g

# ---------------------------------------------------------------------------
# Ports auf dem Host
# ---------------------------------------------------------------------------
IIQ_HTTP_PORT=8080
IIQ_DEBUG_PORT=8000
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
DBGATE_PORT=5050
LDAP_PORT=1389
LDAP_UI_PORT=5080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Superuser - legt beim ersten Start die IIQ-Datenbanken an.
POSTGRES_PASSWORD=postgres

# Die drei IIQ-Datenbankbenutzer.
# ACHTUNG: Diese Werte werden beim Image-Build in die SailPoint-DDL
# eingesetzt. Nach einer Aenderung ist ein Rebuild noetig:
#     docker compose build postgres && docker compose down -v && docker compose up -d
IIQ_DB_USER=identityiq
IIQ_DB_PASSWORD=identityiq

IIQ_PLUGIN_DB_USER=identityiqPlugin
IIQ_PLUGIN_DB_PASSWORD=identityiqPlugin

IIQ_AH_DB_USER=identityiqah
IIQ_AH_DB_PASSWORD=identityiqah

# ---------------------------------------------------------------------------
# DBGate (Datenbank-Oberflaeche)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# OpenLDAP (Testverzeichnis fuer Aggregation/Provisioning)
# ---------------------------------------------------------------------------
LDAP_ROOT=dc=example,dc=com
LDAP_ADMIN_USER=admin
LDAP_ADMIN_PASSWORD=adminpassword
